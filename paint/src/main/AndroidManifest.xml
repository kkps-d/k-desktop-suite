<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".PaintApplication" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/backup_rules"
        android:icon="@drawable/ic_paint" android:label="@string/app_name"
        android:supportsRtl="true" android:theme="@style/Theme.KDPaint">
        <activity android:name=".PaintActivity" android:exported="true"
            android:resizeableActivity="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/image_paths" />
        </provider>
    </application>
</manifest>

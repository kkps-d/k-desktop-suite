<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:name=".NotepadApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KDNotepad"
        android:localeConfig="@xml/core_ui_supported_locales" tools:targetApi="33">
        <property android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI" android:value="true" />
        <activity
            android:name=".NotepadActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
        </activity>
        <activity-alias android:name=".LauncherClassicSystem"
            android:targetActivity=".NotepadActivity" android:enabled="true"
            android:exported="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClassicLight"
            android:targetActivity=".NotepadActivity" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_launcher_classic_light" android:roundIcon="@mipmap/ic_launcher_classic_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClassicDark"
            android:targetActivity=".NotepadActivity" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_launcher_classic_dark" android:roundIcon="@mipmap/ic_launcher_classic_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGlassSystem"
            android:targetActivity=".NotepadActivity" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_launcher_glass_system" android:roundIcon="@mipmap/ic_launcher_glass_system"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGlassLight"
            android:targetActivity=".NotepadActivity" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_launcher_glass_light" android:roundIcon="@mipmap/ic_launcher_glass_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGlassDark"
            android:targetActivity=".NotepadActivity" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_launcher_glass_dark" android:roundIcon="@mipmap/ic_launcher_glass_dark"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
